  "query": "\n            SELECT\n                id,\n                user_id,\n                email,\n                full_name,\n                allowed_storage,\n                taken_storage,\n                is_blocked,\n                created_at,\n                updated_at,\n                version\n            FROM console_users\n            WHERE ($1::bool IS NULL OR is_blocked = $1)\n            ORDER BY updated_at DESC\n            LIMIT $2\n            ",
