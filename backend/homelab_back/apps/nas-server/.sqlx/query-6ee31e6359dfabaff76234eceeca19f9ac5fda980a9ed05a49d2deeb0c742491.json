{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                f.id,\n                f.name,\n                f.owner_id,\n                f.parent_folder_id,\n                f.file_type as \"file_type: _\",\n                f.is_deleted,\n                f.ttl,\n                f.size,\n                f.upload_status as \"upload_status: _\", \n                f.created_at, \n                f.updated_at,\n                f.hash,\n                f.deleted_at\n            FROM files f\n            INNER JOIN file_labels fl ON f.id = fl.file_id\n            WHERE fl.label_id = $1 AND f.owner_id = $2\n            ",
