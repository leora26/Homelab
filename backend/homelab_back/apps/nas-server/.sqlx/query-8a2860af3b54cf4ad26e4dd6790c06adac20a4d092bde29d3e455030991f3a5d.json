{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT f.* FROM folders f\n        LEFT JOIN folders p ON f.parent_folder_id = p.id\n        WHERE f.is_deleted = true \n          AND f.owner_id = $1\n          AND (p.id IS NULL OR p.is_deleted = false)\n        ",
