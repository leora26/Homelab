{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                l.id,\n                l.name,\n                l.color,\n                l.owner_id,\n                l.created_at,\n                COUNT(fl.file_id) AS \"file_count!\"\n            FROM labels l\n            LEFT JOIN file_labels fl ON fl.label_id = l.id\n            WHERE l.owner_id = $1\n            GROUP BY l.id\n            ORDER BY l.name\n            ",
