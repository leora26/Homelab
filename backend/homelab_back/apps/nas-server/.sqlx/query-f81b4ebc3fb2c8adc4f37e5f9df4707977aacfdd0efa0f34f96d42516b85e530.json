{
  "db_name": "PostgreSQL",
  "query": "\n             SELECT\n                fl.file_id,\n                l.id,\n                l.name,\n                l.color,\n                l.owner_id,\n                l.created_at\n            FROM labels l\n            INNER JOIN file_labels fl ON l.id = fl.label_id\n            WHERE fl.file_id = ANY($1) AND l.owner_id = $2\n            ORDER BY l.name\n            ",
