# Variables for easy maintenance
nas_pkg := "nas-server"
user_pkg := "user-management"
cli_pkg := "cli"

# --- Database Management ---

# Runs all pending migrations for the database [cite: 46]
migrate:
    sqlx migrate run

# Reverts the last migration applied [cite: 46]
revert:
    sqlx migrate revert

# DANGER: Drops and recreates the database from scratch [cite: 46]
reset:
    sqlx database reset -y

# Generates offline query metadata for SQLx for all services [cite: 46]
prepare:
    cd apps/nas-server; cargo sqlx prepare
    cd apps/user-management; cargo sqlx prepare
    cd apps/admin-console; cargo sqlx prepare

# --- Development & Build ---

# Standard check before pushing: migrates, prepares SQLx, formats, and tests [cite: 46]
ready: migrate prepare
    cargo fmt
    cargo test
    @echo "✅ Ready to push!"

# --- Running Services ---

# Populates the NAS database with initial seed data [cite: 1, 46]
seed:
    cargo run -p {{nas_pkg}} --bin seed

# Runs the main NAS backend service [cite: 1, 46]
run-nas:
    cargo run -p {{nas_pkg}} --bin nas-server

# Runs the user management service [cite: 47, 46]
run-user:
     cargo run -p {{user_pkg}}

# --- ZFS Storage Volume (STOR-1) ---
# All logic lives in scripts/zfs.sh; config comes from apps/nas-server/.env or env overrides.

# Provision (idempotent) the ZFS pool, dataset & delegation that back the NAS volume
zfs-provision:
    sudo scripts/zfs.sh provision

# Show the managed dataset's usage / quota / reservation (no root needed)
zfs-status:
    scripts/zfs.sh status

# DANGER: destroy the dev pool and delete its backing image
zfs-destroy:
    sudo scripts/zfs.sh destroy

# --- Admin CLI (pvk) ---

# Run the pvk admin CLI in dev (compiles + runs, no PATH install).
# Usage: `just pvk volume status`   |   `just pvk volume status --output json`
pvk *args:
    cargo run -q -p {{cli_pkg}} --bin pvk -- {{args}}